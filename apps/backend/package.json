{
  "name": "iepf-backend",
  "type": "module",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "cross-env NODE_ENV=test vitest run",
    "build": "tsc && tsc-alias",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:clean": "tsx src/scripts/clean-db.ts && drizzle-kit migrate",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:activator": "tsx src/scripts/seed-activator.ts",
    "seed:class-sections": "tsx src/scripts/seed-class-sections.ts",
    "seed:subjects": "tsx src/scripts/seed-subjects.ts",
    "seed:mocks": "tsx src/scripts/seed-mock-users.ts",
    "seed:mock-tutor-subjects": "tsx src/scripts/seed-mock-tutor-subjects.ts",
    "seed:mock-tutor-weekday-availability": "tsx src/scripts/seed-mock-tutor-weekday-availability.ts",
    "seed:mock-lesson-bookings": "tsx src/scripts/seed-mock-lesson-bookings.ts",
    "seed:global-settings": "tsx src/scripts/seed-global-settings.ts",
    "seed:all-mock-data": "tsx src/scripts/seed-full.ts",
    "generate:lessons": "tsx src/scripts/generate-weekly-lessons.ts",
    "remind:feedback": "tsx src/scripts/remind-missing-feedback.ts",
    "remind:lessons": "tsx src/scripts/remind-upcoming-lessons.ts",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "seed:dev": "tsx src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-openapi": "^1.2.1",
    "@scalar/hono-api-reference": "^0.9.39",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.11.7",
    "hono-pino": "^0.10.3",
    "nodemailer": "^7.0.13",
    "obscenity": "^0.4.6",
    "pg": "^8.18.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "profanities": "^3.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@types/node": "^24.10.9",
    "@types/nodemailer": "^6.4.22",
    "@types/pg": "^8.16.0",
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
