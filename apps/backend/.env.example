NODE_ENV=development
PORT=9999
LOG_LEVEL=debug
DATABASE_URL=postgresql://iepf:iepf_local_password@127.0.0.1:5432/iepf_dev
PASSWORD_SALT=random_salt_b64
JWT_SECRET=super_long_random_secret_value_change_me
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=900
SITE_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IEPF <no-reply@example.test>"
SMTP_DEBUG=false
PROFANITY_EXTRA_WORDS=
# Web Push: all three or none. Generate the pair with `pnpm run push:vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:iepf@hensemberger.it
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ACTIVATOR_EMAIL=activator@example.com
ACTIVATOR_PASSWORD=ChangeMe123!
ACTIVATOR_FIRST_NAME=Activator
ACTIVATOR_LAST_NAME=User

# Tutor invite token TTL (seconds)
TUTOR_INVITE_TTL=604800
ADMIN_INVITE_TTL=604800
