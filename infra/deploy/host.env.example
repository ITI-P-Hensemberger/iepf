# Copy to /opt/iepf/shared/host.env. Never source this file as shell code.
DEPLOY_ROOT=/opt/iepf
# MUST match the existing com.docker.compose.project label during migration.
COMPOSE_PROJECT_NAME=iepf
# Keep existing absolute bind-mount paths; do not copy or initialize the database.
POSTGRES_DATA_DIR=/opt/infra/iepf/postgres-data
ACME_DIR=/root/iepf/letsencrypt
# Before first deploy: replace with the EXACT currently running image digests.
# docker inspect postgres traefik --format '{{.Name}} {{.Config.Image}} {{.Image}}'
# docker image inspect IMAGE_ID --format '{{json .RepoDigests}}'
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_CURRENT_DIGEST
TRAEFIK_IMAGE=traefik@sha256:REPLACE_WITH_CURRENT_DIGEST
